rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'gamesPlayed',
          'gamesWon',
          'currentStreak',
          'maxStreak',
          'completedPuzzleIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'gamesPlayed',
          'gamesWon',
          'currentStreak',
          'maxStreak',
          'completedPuzzleIds',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.gamesPlayed is int
        && data.gamesPlayed >= 0
        && data.gamesPlayed <= 100000
        && data.gamesWon is int
        && data.gamesWon >= 0
        && data.gamesWon <= data.gamesPlayed
        && data.currentStreak is int
        && data.currentStreak >= 0
        && data.currentStreak <= data.gamesWon
        && data.maxStreak is int
        && data.maxStreak >= data.currentStreak
        && data.maxStreak <= data.gamesWon
        && data.completedPuzzleIds is list
        && data.completedPuzzleIds.size() <= 500
        && (data.completedPuzzleIds.size() == 0 || (data.completedPuzzleIds[0] is string && data.completedPuzzleIds[0].size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function ownsParentProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    function isValidPuzzleProgress(data, userId, puzzleId) {
      return data.keys().hasAll([
          'puzzleId',
          'ownerId',
          'solvedGroupIds',
          'guesses',
          'mistakesRemaining',
          'status',
          'tileOrder',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'puzzleId',
          'ownerId',
          'solvedGroupIds',
          'guesses',
          'mistakesRemaining',
          'status',
          'tileOrder',
          'createdAt',
          'updatedAt'
        ])
        && data.puzzleId is string
        && data.puzzleId == puzzleId
        && isValidId(data.puzzleId)
        && data.puzzleId.size() <= 64
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.solvedGroupIds is list
        && data.solvedGroupIds.size() <= 4
        && (data.solvedGroupIds.size() == 0 || (data.solvedGroupIds[0] is string && data.solvedGroupIds[0].size() <= 64))
        && data.guesses is list
        && data.guesses.size() <= 8
        && (
          data.guesses.size() == 0
          || (
            data.guesses[0] is map
            && data.guesses[0].keys().hasAll(['tiles'])
            && data.guesses[0].keys().hasOnly(['tiles'])
            && data.guesses[0].tiles is list
            && data.guesses[0].tiles.size() == 4
            && data.guesses[0].tiles[0] is string
            && data.guesses[0].tiles[0].size() <= 120
          )
        )
        && data.mistakesRemaining is int
        && data.mistakesRemaining >= 0
        && data.mistakesRemaining <= 4
        && data.status in ['playing', 'won', 'lost']
        && data.tileOrder is list
        && data.tileOrder.size() <= 16
        && (data.tileOrder.size() == 0 || (data.tileOrder[0] is string && data.tileOrder[0].size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: UpdateProfile
          (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']))
          // Action: RecordStats
          || (incoming().diff(existing()).affectedKeys().hasOnly(['gamesPlayed', 'gamesWon', 'currentStreak', 'maxStreak', 'completedPuzzleIds', 'updatedAt']))
        );

      allow delete: if false;

      match /progress/{puzzleId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(puzzleId)
          && ownsParentProfile(userId);

        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(puzzleId)
          && isValidPuzzleProgress(incoming(), userId, puzzleId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && ownsParentProfile(userId);

        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(puzzleId)
          && isValidPuzzleProgress(incoming(), userId, puzzleId)
          && existing().status == 'playing'
          && incoming().ownerId == existing().ownerId
          && incoming().puzzleId == existing().puzzleId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && ownsParentProfile(userId)
          && (
            // Action: ShuffleBoard
            (incoming().status == 'playing' && incoming().diff(existing()).affectedKeys().hasOnly(['tileOrder', 'updatedAt']))
            // Action: SubmitGuess
            || (incoming().diff(existing()).affectedKeys().hasOnly(['solvedGroupIds', 'guesses', 'mistakesRemaining', 'status', 'tileOrder', 'updatedAt']))
          );

        allow delete: if false;
      }
    }
  }
}
