{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated player profile and aggregate statistics.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name from Google account."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified Google account email address."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional profile avatar URL."
        },
        "gamesPlayed": {
          "type": "integer",
          "description": "Total completed puzzles played."
        },
        "gamesWon": {
          "type": "integer",
          "description": "Total puzzles solved."
        },
        "currentStreak": {
          "type": "integer",
          "description": "Current consecutive win streak."
        },
        "maxStreak": {
          "type": "integer",
          "description": "Best consecutive win streak."
        },
        "completedPuzzleIds": {
          "type": "array",
          "description": "Bounded list of completed puzzle IDs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last stats update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "gamesPlayed",
        "gamesWon",
        "currentStreak",
        "maxStreak",
        "completedPuzzleIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "PuzzleProgress": {
      "title": "PuzzleProgress",
      "description": "Per-edition game progress for an authenticated player.",
      "type": "object",
      "properties": {
        "puzzleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifier of the puzzle edition."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owning player."
        },
        "solvedGroupIds": {
          "type": "array",
          "description": "IDs of groups solved so far (max 4)."
        },
        "guesses": {
          "type": "array",
          "description": "Chronological list of guess objects ({ tiles: string[] }, max 8)."
        },
        "mistakesRemaining": {
          "type": "integer",
          "description": "Remaining mistakes from 0 to 4."
        },
        "status": {
          "type": "string",
          "enum": ["playing", "won", "lost"],
          "description": "Current game outcome state."
        },
        "tileOrder": {
          "type": "array",
          "description": "Current ordered list of remaining unsolved tiles (max 16)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of progress creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last board update."
        }
      },
      "required": [
        "puzzleId",
        "ownerId",
        "solvedGroupIds",
        "guesses",
        "mistakesRemaining",
        "status",
        "tileOrder",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile and aggregate stats owned strictly by {userId}."
    },
    "/users/{userId}/progress/{puzzleId}": {
      "schema": {
        "$ref": "#/entities/PuzzleProgress"
      },
      "description": "Per-edition game progress documents owned strictly by {userId}."
    }
  }
}
